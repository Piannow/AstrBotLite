<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wizardScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="欢迎使用 AstrBot Lite"
            android:textColor="@color/colorPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="三步完成配置，让 QQ 官方机器人接入 AI"
            android:textColor="@color/textSub"
            android:textSize="13sp" />

        <!-- ① QQ 机器人 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="① 连接 QQ 官方机器人"
            android:textColor="@color/textMain"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="在 q.qq.com/qqbot 开放平台创建机器人后，到「开发设置」复制 AppID 与 AppSecret"
            android:textColor="@color/textSub"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etAppId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="AppID（机器人应用ID）"
            android:inputType="text"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etSecret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="AppSecret（机器人密钥）"
            android:inputType="textPassword"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnTestQq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="测试连接" />

        <TextView
            android:id="@+id/tvQqResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/textSub"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etApiBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="API 地址（高级）：一般无需修改；正式 api.sgroup.qq.com"
            android:inputType="textUri"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="连接环境"
            android:textColor="@color/textMain"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spEnv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="默认正式环境；若机器人未发布只能选沙箱（在开放平台添加沙箱测试账号）"
            android:textColor="@color/textSub"
            android:textSize="11sp" />

        <!-- ② AI 模型 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="② 接入 AI 大模型"
            android:textColor="@color/textMain"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="API 地址（OpenAI 兼容）"
            android:inputType="textUri"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etApiKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="API Key"
                android:inputType="textPassword"
                android:maxLines="1" />

            <Button
                android:id="@+id/btnCopyApiKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="复制"
                android:textSize="12sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="模型名（如 deepseek-chat）"
            android:inputType="text"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnListModels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="获取当前模型列表"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvModelsResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/textSub"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnTestAi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="测试 AI 对话" />

        <TextView
            android:id="@+id/tvAiResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/textSub"
            android:textSize="12sp" />

        <!-- ③ 人设卡 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="③ 选择人设卡"
            android:textColor="@color/textMain"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spPersona"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnNewPersona"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="新建人设卡" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="保存并启动机器人"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="取消（暂不配置）" />
    </LinearLayout>
</ScrollView>
