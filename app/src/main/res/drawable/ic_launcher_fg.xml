<?xml version="1.0" encoding="utf-8"?>
<!-- 图标：2×2 色块（白 / 靛蓝 / 黑 / 白），硬边、无圆角、无渐变。
     自适应前景只画有色块；白色块与背景层同为白色，形成对角构图。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 右上：靛蓝 -->
    <path
        android:fillColor="#3F48CC"
        android:pathData="M55,26 H82 V53 H55 Z" />
    <!-- 左下：黑 -->
    <path
        android:fillColor="#000000"
        android:pathData="M26,55 H53 V82 H26 Z" />
    <!-- 左上 / 右下：白（与背景同色，保留完整 2×2 结构） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M26,26 H53 V53 H26 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M55,55 H82 V82 H55 Z" />
</vector>
