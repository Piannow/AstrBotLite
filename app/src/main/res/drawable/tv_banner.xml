<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV 横幅：2×2 色块（白 / 靛蓝 / 黑 / 白）硬边风格 + 抽象字标条 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- 白色背景 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M0,0 H320 V180 H0 Z" />

    <!-- 2×2 色块：右上靛蓝、左下黑（左上 / 右下为白色） -->
    <path
        android:fillColor="#3F48CC"
        android:pathData="M74,24 H120 V70 H74 Z" />
    <path
        android:fillColor="#000000"
        android:pathData="M24,74 H70 V120 H24 Z" />

    <!-- 右侧字标条 -->
    <path
        android:fillColor="#000000"
        android:pathData="M146,52 H300 V66 H146 Z" />
    <path
        android:fillColor="#000000"
        android:pathData="M146,76 H262 V90 H146 Z" />
    <path
        android:fillColor="#3F48CC"
        android:pathData="M146,100 H206 V110 H146 Z" />
</vector>
