<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 9 及以下申请读写外部存储权限（聊天记录/文件导出） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 兼容平板 / 机顶盒（Android TV） -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:resizeable="true"
        android:smallScreens="true"
        android:xlargeScreens="true" />

    <application
        android:name=".App"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 1.7.108：加 configChanges——旋转不再重建 Activity（否则用户一切横竖屏就"回到主页"，
             且挂在内容区上的安装进度条随重建消失） -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />

        <activity
            android:name=".ui.LogViewActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ChatHistoryActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />

        <activity
            android:name=".ui.NetdiskLoginActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />

        <activity
            android:name=".ui.WizardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.TestConsoleActivity"
            android:exported="false" />

        <activity
            android:name=".ui.InitActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 让应用出现在 Android TV 启动器 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Python 插件网页界面：App 内 WebView 直读本地 webui 资源（不启 http 服务）。
             configChanges：横竖屏切换不重建、页面状态保留；adjustResize：手机弹键盘不遮挡输入框 -->
        <activity
            android:name=".ui.PluginWebUiActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />

        <!-- B 站登录（看番助手 2.2.0）：WebView 扫码/账密 + cookie 粘贴，登录态保留 -->
        <activity
            android:name=".ui.BiliLoginActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />

        <!-- 知识库管理页（1.7.224 起从设置页「知识库」按钮打开） -->
        <activity
            android:name=".ui.KnowledgeActivity"
            android:exported="false" />

        <!-- 文件浏览器（恢复 1.7.222 功能）：为 ZIP 安装/导入配置提供本地文件选择 -->
        <activity
            android:name=".ui.FileBrowserActivity"
            android:exported="false" />

        <service
            android:name=".service.BotService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
